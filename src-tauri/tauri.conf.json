{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forgor",
  "version": "0.1.0",
  "identifier": "com.llefu.forgor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forgor",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "popup",
        "title": "Forgor: Quick menu",
        "url": "popup.html",
        "width": 560,
        "height": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Work notes and todos",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRTlEM0EzNTkxRDAzQjQKUldTMEF4MVpvOVBwNGZXS1VIVVhCMERZU3lBTjJHMUZVdDJuYUc4V1B4azU5b2NBL1VhRERUMjkK",
      "endpoints": [
        "https://github.com/LLefu/Forgor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
