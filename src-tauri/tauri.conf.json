{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forgor",
  "version": "1.1.0",
  "identifier": "com.llefu.forgor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Forgor",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "popup",
        "title": "Forgor: Quick menu",
        "url": "popup.html",
        "width": 560,
        "height": 420,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "frame-src": "https:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Work notes and todos",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxRTlEM0EzNTkxRDAzQjQKUldTMEF4MVpvOVBwNGZXS1VIVVhCMERZU3lBTjJHMUZVdDJuYUc4V1B4azU5b2NBL1VhRERUMjkK",
      "endpoints": [
        "https://github.com/LLefu/Forgor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "sql": {
      "preload": [
        "sqlite:forgor.db"
      ]
    }
  }
}
