{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window and the quick popup. Files: only the installed plugins' folder here; the notes folder is granted at runtime (src-tauri/src/access.rs). Opening files goes through access::open_path. The database is preloaded (tauri.conf.json), so no sql:allow-load.",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-unminimize",
    "core:webview:allow-set-webview-zoom",
    "core:event:allow-emit-to",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "sql:allow-select",
    "sql:allow-execute",
    "dialog:default",
    "fs:deny-default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/plugins"
        },
        {
          "path": "$APPDATA/plugins/**"
        }
      ],
      "deny": [
        {
          "path": "**/.git"
        },
        {
          "path": "**/.git/**"
        },
        {
          "path": "**/.obsidian"
        },
        {
          "path": "**/.obsidian/**"
        },
        {
          "path": "**/.vscode"
        },
        {
          "path": "**/.vscode/**"
        },
        {
          "path": "**/.idea"
        },
        {
          "path": "**/.idea/**"
        },
        {
          "path": "**/.github"
        },
        {
          "path": "**/.github/**"
        },
        {
          "path": "**/.husky"
        },
        {
          "path": "**/.husky/**"
        }
      ]
    },
    "updater:default",
    "process:allow-restart",
    "notification:default"
  ]
}
